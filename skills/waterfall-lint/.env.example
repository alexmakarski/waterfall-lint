# Copy to .env and fill in, or export these in your shell.
# The helper scripts check, in order: the environment, this .env file,
# ~/.env, then ~/.zshrc / ~/.bashrc / ~/.bash_profile / ~/.profile.

# xAI API key for the Grok critic. https://x.ai/api
XAI_API_KEY=

# Google AI Studio API key for the Gemini critic. https://ai.google.dev/
GEMINI_API_KEY=

# Key for the DeepSeek critic's endpoint. Default endpoint is Fireworks
# (US-hosted, https://fireworks.ai). To route elsewhere (first-party PRC-hosted
# api.deepseek.com, or self-hosted vLLM), set DEEPSEEK_BASE_URL
# (OpenAI-compatible, /v1 included) and DEEPSEEK_MODEL to that host's model id.
DEEPSEEK_API_KEY=
#DEEPSEEK_BASE_URL=https://api.fireworks.ai/inference/v1
#DEEPSEEK_MODEL=accounts/fireworks/models/deepseek-v4-pro
